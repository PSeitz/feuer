+++ b/feuer-storage/src/read_observer.rs
@@ -0,0 +1,37 @@
+use std::{hash::{Hash, Hasher}, io::Write, sync::{Mutex, OnceLock, atomic::{AtomicU64, Ordering}}, time::Instant};
+use feuer_types::{ByteRange, ObjectKeyHash};
+
+static NEXT: AtomicU64 = AtomicU64::new(1);
+static EVENTS: Mutex<Vec<Event>> = Mutex::new(Vec::new());
+static ORIGIN: OnceLock<Instant> = OnceLock::new();
+
+struct Event {
+    time: u128,
+    kind: &'static str,
+    task: u64,
+    key: u128,
+    start: u64,
+    end: u64,
+    read: u64,
+    address: u64,
+    flag: bool,
+}
+
+pub fn next_read() -> u64 { NEXT.fetch_add(1, Ordering::Relaxed) }
+
+pub fn record(kind: &'static str, key: ObjectKeyHash, range: Option<ByteRange>, read: u64, address: u64, flag: bool) {
+    let mut hasher = std::hash::DefaultHasher::new();
+    tokio::task::try_id().hash(&mut hasher);
+    let mut events = EVENTS.lock().unwrap();
+    let time = ORIGIN.get_or_init(Instant::now).elapsed().as_nanos();
+    events.push(Event { time, kind, task: hasher.finish(), key: key.0, start: range.map_or(0, ByteRange::start), end: range.map_or(0, ByteRange::end), read, address, flag });
+}
+
+pub fn dump(path: impl AsRef<std::path::Path>) -> std::io::Result<()> {
+    let mut file = std::io::BufWriter::new(std::fs::File::create(path)?);
+    writeln!(file, "time_ns,kind,task,key,start,end,read,address,flag")?;
+    for event in EVENTS.lock().unwrap().iter() {
+        writeln!(file, "{},{},{},{},{},{},{},{},{}", event.time, event.kind, event.task, event.key, event.start, event.end, event.read, event.address, u8::from(event.flag))?;
+    }
+    file.flush()
+}
