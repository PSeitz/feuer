+#[tokio::test]
+async fn partial_checksums_reduce_read_bytes_without_writes_and_reset_on_recovery() {
+    let (directory, cache, registry) = measured_cache(4 * CHUNK_BYTES).await;
+    let key = ObjectKeyHash::from("partial");
+    let source = tests::download(u64::MAX - 3 * CHUNK_BYTES, 2 * CHUNK_BYTES as usize + 17);
+    let start = source.downloaded_range().start();
+    let request = tests::range(start + 4093, start + 4093 + 65_543);
+    let nested = tests::range(request.start() + 7, request.start() + 40_007);
+    // Padding makes a repeated read exceed the 32-KiB buffer bucket, then copying shrinks it back.
+    let threshold = tests::range(start + 1, start + 1 + 32 * 1024);
+    cache.insert(key, source.clone()).await.unwrap();
+    let read_bytes = || value(&registry, "feuer_disk_io_bytes_total", &[("operation", "read")]);
+    let written = value(&registry, "feuer_disk_io_bytes_total", &[("operation", "write")]);
+    for (range, expected_read) in [
+        (request, source.downloaded_range().len()),
+        (request, request.len()),
+        (nested, request.len()),
+        (nested, nested.len()),
+        (threshold, source.downloaded_range().len()),
+        (threshold, threshold.len()),
+        (source.downloaded_range(), source.downloaded_range().len()),
+    ] {
+        let before = read_bytes();
+        let (bytes, capacity) = cache.fetch_from_disk(&key, range).await.unwrap();
+        assert_eq!(bytes, source.bytes_in_range(range));
+        assert_eq!(capacity, BufferPool::allocation_capacity(bytes.len()));
+        assert_eq!(read_bytes() - before, expected_read as f64);
+    }
+    {
+        let index = cache.disk.shards[0].entry_index.lock().unwrap();
+        let entry = &index.entries_by_key[&key][&start];
+        assert_eq!(entry.partial_checksums.len(), 3);
+        assert!(entry.in_flight_read.upgrade().is_none());
+        assert!(
+            entry
+                .partial_checksums
+                .iter()
+                .all(|part| part.in_flight_read.upgrade().is_none())
+        );
+    }
+    assert_eq!(value(&registry, "feuer_disk_entries", &[]), 1.0);
+    assert_eq!(
+        value(&registry, "feuer_disk_payload_bytes", &[]),
+        source.bytes().len() as f64
+    );
+    assert_eq!(
+        value(&registry, "feuer_disk_io_bytes_total", &[("operation", "write")]),
+        written
+    );
+
+    cache.write_dirty_metadata_pages().await;
+    drop(cache);
+    let (recovered_registry, backend) = crate::test_metrics::registry();
+    let cache = DiskCache::open(
+        directory.path(),
+        4 * CHUNK_BYTES,
+        DiskCacheOptions {
+            io_metrics: IoMetrics::new(&backend),
+            ..Default::default()
+        },
+    )
+    .await
+    .unwrap();
+    let read_bytes = || {
+        value(
+            &recovered_registry,
+            "feuer_disk_io_bytes_total",
+            &[("operation", "read")],
+        )
+    };
+    for expected_read in [source.bytes().len() as u64, request.len()] {
+        let before = read_bytes();
+        assert_eq!(cache.get(&key, request).await.unwrap(), source.bytes_in_range(request));
+        assert_eq!(read_bytes() - before, expected_read as f64);
+    }
+}
