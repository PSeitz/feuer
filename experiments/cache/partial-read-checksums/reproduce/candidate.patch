+#[tokio::test]
+async fn concurrent_partial_reads_share_io_and_learn_each_range_once() {
+    use std::{future::Future, task::Poll};
+
+    let (_directory, cache, registry) = measured_cache(3 * CHUNK_BYTES).await;
+    let key = ObjectKeyHash::from("concurrent partial");
+    let source = tests::download(17, CHUNK_BYTES as usize);
+    let request = tests::range(4110, 69_653);
+    cache.insert(key, source.clone()).await.unwrap();
+    assert!(cache.get(&key, request).await.is_some());
+    let read = cache.disk.shards[0]
+        .entry_index
+        .lock()
+        .unwrap()
+        .covering_entry(&key, request)
+        .unwrap()
+        .share_payload_read(Some(request));
+    assert_eq!(read.object_range, request);
+    let mut initializer = Box::pin(read.result.get_or_init(std::future::pending));
+    assert!(
+        std::future::poll_fn(|cx| Poll::Ready(initializer.as_mut().poll(cx)))
+            .await
+            .is_pending()
+    );
+    let mut first = Box::pin(cache.fetch_from_disk(&key, request));
+    let mut second = Box::pin(cache.fetch_from_disk(&key, request));
+    for waiter in [&mut first, &mut second] {
+        assert!(
+            std::future::poll_fn(|cx| Poll::Ready(waiter.as_mut().poll(cx)))
+                .await
+                .is_pending()
+        );
+    }
+    assert_eq!(Arc::strong_count(&read), 3);
+    let weak = Arc::downgrade(&read);
+    drop(initializer);
+    drop(read);
+    let before = value(&registry, "feuer_disk_io_bytes_total", &[("operation", "read")]);
+    let (first, second) = tokio::join!(first, second);
+    let (first, first_capacity) = first.unwrap();
+    let (second, second_capacity) = second.unwrap();
+    assert_eq!(first, source.bytes_in_range(request));
+    assert_eq!(first, second);
+    assert_eq!(first.as_ptr(), second.as_ptr());
+    assert_eq!(first_capacity, BufferPool::allocation_capacity(request.len() as usize));
+    assert_eq!(first_capacity, second_capacity);
+    assert!(weak.upgrade().is_none());
+    assert_eq!(
+        value(&registry, "feuer_disk_io_bytes_total", &[("operation", "read")]) - before,
+        request.len() as f64
+    );
+    assert_eq!(
+        cache.disk.shards[0].entry_index.lock().unwrap().entries_by_key[&key][&17]
+            .partial_checksums
+            .len(),
+        1
+    );
+}
